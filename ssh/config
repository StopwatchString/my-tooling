# ssh config shared across machines. setup.sh includes it (after any
# downstream layers' ssh/config) from a block at the bottom of ~/.ssh/config;
# per-machine lines go above that block. ~/.ssh/config.local still works.
# ssh uses the first value it finds for each option, so order matters:
# host-specific blocks first, the agent selection and defaults last.

Include ~/.ssh/config.local

Host plato
  HostName 192.168.0.40
  User mspeck
  ForwardAgent yes

Host socrates
  HostName 192.168.0.41
  User mspeck
  ForwardAgent yes

# MacBook Pro; no fixed IP, so reach it over mDNS (avahi on Linux).
Host macbook
  HostName Masons-MacBook-Pro.local
  User masonspeck
  ForwardAgent yes

# Agent selection. Use the local 1Password agent only in a local session
# where its socket exists. Inside an ssh session (SSH_CONNECTION set) the
# forwarded agent in $SSH_AUTH_SOCK wins instead; otherwise 1Password would
# pop a GUI approval prompt that nobody connected remotely can answer.
Match exec 'test -z "$SSH_CONNECTION" -a -S ~/.1password/agent.sock'
  IdentityAgent ~/.1password/agent.sock

Match exec 'test -z "$SSH_CONNECTION" -a -S ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock'
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
